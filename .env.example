# Required for AI analysis and resume tailoring. Create your key at
# https://platform.openai.com/api-keys and keep it out of version control.
OPENAI_API_KEY=

# These defaults are explicit so the two pipeline stages stay independently configurable.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TAILOR_MODEL=gpt-5.6-terra

# Optional. Leave unset to use https://api.openai.com/v1.
# OPENAI_BASE_URL=https://api.openai.com/v1
